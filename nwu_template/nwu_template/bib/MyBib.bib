% ============================================================
%  MyBib.bib  –  BibTeX reference database
%  Managed with JabRef (https://www.jabref.org) or any BibTeX editor
%  Style: IEEE (numeric, as configured in NWUStyle.sty)
% ============================================================

% ── Journal article ─────────────────────────────────────────
@article{example_ref,
  author   = {Author, A. B. and Second, C. D.},
  title    = {Title of the journal article},
  journal  = {Journal Name},
  volume   = {12},
  number   = {3},
  pages    = {100--115},
  year     = {2023},
  doi      = {10.xxxx/xxxxxxx},
}

% ── Book ────────────────────────────────────────────────────
@book{example_book,
  author    = {Author, E. F.},
  title     = {Title of the Book},
  edition   = {3rd},
  publisher = {Publisher Name},
  address   = {City},
  year      = {2021},
  isbn      = {978-0-000-00000-0},
}

% ── Conference paper ────────────────────────────────────────
@inproceedings{example_conference,
  author    = {Author, G. H. and Co-Author, I. J.},
  title     = {Title of the conference paper},
  booktitle = {Proceedings of the International Conference on XYZ},
  address   = {City, Country},
  year      = {2022},
  pages     = {45--52},
  doi       = {10.xxxx/xxxxxxx},
}

% ── Online resource / datasheet ─────────────────────────────
@online{example_datasheet,
  author       = {{Manufacturer Name}},
  title        = {Product Datasheet: Part Number XYZ},
  year         = {2023},
  url          = {https://www.manufacturer.com/datasheet.pdf},
  urldate      = {2024-11-01},
  note         = {[Online; accessed 1 November 2024]},
}

% ── Technical report ────────────────────────────────────────
@techreport{example_techreport,
  author      = {Author, K. L.},
  title       = {Title of Technical Report},
  institution = {Organisation Name},
  year        = {2020},
  number      = {TR-2020-001},
  url         = {https://www.org.com/report.pdf},
}
